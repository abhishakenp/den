<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>io.github.abhishakenp.den</string>
  <key>CFBundleName</key><string>den</string>
  <key>CFBundleDisplayName</key><string>den</string>
  <key>CFBundleExecutable</key><string>den</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <!-- den checks in as a UI element and makes itself a regular (Dock) app in main.swift, unless
       launched with --background (automation), which must never show a Dock tile. -->
  <key>LSUIElement</key><true/>
  <!-- malloc keeps freed large blocks cached and dirty. Compiling content rule lists (Shields'
       lists on a first launch, an extension's declarativeNetRequest rules) peaks at 300-600 MB in
       den's process and left 35-40 MB of those blocks behind for the whole session; with the cache
       off den is back at its idle 18.5 MB afterwards (perf lab, docs/perf/baseline.md).
       malloc_zone_pressure_relief doesn't release them. -->
  <key>LSEnvironment</key>
  <dict>
    <key>MallocLargeCache</key><string>0</string>
  </dict>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticTermination</key><false/>
  <!-- Host updates (Sparkle). The updates plugin schedules checks; Sparkle never checks on its own. -->
  <key>SUFeedURL</key><string>https://raw.githubusercontent.com/abhishakenp/den/main/updates/appcast.xml</string>
  <key>SUPublicEDKey</key><string>UNsZIwddapFh5BCXdYV9aqdxHczVYNydfhYFcsuFzFU=</string>
  <key>SUEnableAutomaticChecks</key><false/>
  <key>SUAutomaticallyUpdate</key><false/>
  <key>NSCameraUsageDescription</key><string>A website you allowed wants to use your camera.</string>
  <key>NSMicrophoneUsageDescription</key><string>A website you allowed wants to use your microphone.</string>
  <key>NSLocationUsageDescription</key><string>A website you allowed wants to know your location.</string>
  <!-- Handoff: pages from Safari on your other devices come to den when it's the default browser. -->
  <key>NSUserActivityTypes</key>
  <array><string>NSUserActivityTypeBrowsingWeb</string></array>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>Web site URL</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>http</string><string>https</string></array>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>HTML document</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key><array><string>public.html</string><string>public.xhtml</string></array>
    </dict>
  </array>
</dict>
</plist>
